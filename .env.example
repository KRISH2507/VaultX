# Application Environment
ENVIRONMENT=development
PROJECT_NAME="VaultX Financial Ledger Engine"
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL with asyncpg)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vaultx
POSTGRES_PASSWORD=vaultx_secret
POSTGRES_DB=vaultx_db
DATABASE_URL=postgresql+asyncpg://vaultx:vaultx_secret@localhost:5432/vaultx_db
SYNC_DATABASE_URL=postgresql+psycopg2://vaultx:vaultx_secret@localhost:5432/vaultx_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
