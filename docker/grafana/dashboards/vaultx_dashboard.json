  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "ACID Transfer Throughput (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(vaultx_transfers_total[15s]))",
          "legendFormat": "Total Transfers/sec",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(vaultx_transfers_total{status=\"committed\"}[15s]))",
          "legendFormat": "Committed Transfers/sec",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Settlement Latency (ms) - p50 / p95 / p99",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(vaultx_transfer_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 Latency (ms)",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(vaultx_transfer_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 Latency (ms)",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(vaultx_transfer_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50 Latency (ms)",
          "range": true,
          "refId": "C"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "id": 3,
      "title": "Active In-Flight Transfer Locks",
      "type": "gauge",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "vaultx_active_transfer_locks",
          "legendFormat": "Active Locks",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "id": 4,
      "title": "Transfers by Status",
      "type": "piechart",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum by (status) (vaultx_transfers_total)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 5,
      "title": "Outbox Events Dispatched / sec",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(vaultx_outbox_events_processed_total[15s]))",
          "legendFormat": "Outbox Events/sec",
          "refId": "A"
        }
      ]
    }
